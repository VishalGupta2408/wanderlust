<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3><%= listing.title %></h3>
    </div>

    <div class="row col-8 offset-2 mt-2">
        <!-- Listing Details (Left Column) -->
        <div class="col-md-7 ps-0">
            <div class="card show-card listing-card">
                <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=60' %>"
                    class="card-img-top show-img" alt="listing_image">

                <div class="card-body mt-2">
                    <p class="card-text">
                        Owned By <i><%= listing.owner ? listing.owner.username : "Unknown User" %></i>
                    </p>
                    <p class="card-text"><%= listing.description %></p>
                    <p class="card-text"><b>&#8377; <%= (listing.price || 0).toLocaleString("en-IN") %></b> / night</p>
                    <p class="card-text"><%= listing.location %>, <%= listing.country %></p>
                </div>
            </div>

            <!-- Edit & Delete Buttons for Listing Owner -->
            <% if (currUser && listing.owner && (currUser._id.toString()===listing.owner._id.toString())) { %>
                <div class="btns mt-3 p-0">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn me-3" style="width: 80px; height: 40px;">Edit</a>
                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                        <button class="btn btn-dark" style="width: 80px; height: 40px;">Delete</button>
                    </form>
                </div>
            <% } %>
        </div>

        <!-- Booking Widget Card (Right Column) -->
        <div class="col-md-5 pe-0">
            <div class="card p-3 shadow-sm border rounded-3 mb-4 sticky-top" style="top: 6rem;">
                <h4 class="mb-2"><b>&#8377; <%= (listing.price || 0).toLocaleString("en-IN") %></b> <span class="fs-6 text-muted">/ night</span></h4>
                <hr class="my-2">

                <form action="/listings/<%= listing._id %>/bookings" method="POST" class="needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="checkIn" class="form-label font-weight-bold">Check-in Date</label>
                        <input type="date" id="checkIn" name="booking[checkIn]" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label for="checkOut" class="form-label font-weight-bold">Check-out Date</label>
                        <input type="date" id="checkOut" name="booking[checkOut]" class="form-control" required />
                    </div>

