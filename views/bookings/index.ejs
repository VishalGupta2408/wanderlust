<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-10 offset-1">
        <h2 class="mb-4"><i class="fa-solid fa-plane-departure text-danger me-2"></i>My Trips</h2>

        <!-- Upcoming Trips -->
        <h4 class="mb-3">Upcoming Trips</h4>
        <% if (upcomingBookings && upcomingBookings.length > 0) { %>
            <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mb-5">
                <% for (let booking of upcomingBookings) { %>
                    <div class="col mb-4">
                        <div class="card h-100 shadow-sm border-0 rounded-3">
                            <% if (booking.listing) { %>
                                <img src="<%= booking.listing.image && booking.listing.image.url ? booking.listing.image.url : 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e' %>" 
                                     class="card-img-top" 
                                     alt="<%= booking.listing.title %>"
                                     style="height: 12rem; object-fit: cover; border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem;">
                                <div class="card-body">
                                    <h5 class="card-title text-truncate">
                                        <a href="/listings/<%= booking.listing._id %>" class="text-dark text-decoration-none"><%= booking.listing.title %></a>
                                    </h5>
                                    <p class="text-muted small mb-2"><i class="fa-solid fa-location-dot me-1"></i><%= booking.listing.location %>, <%= booking.listing.country %></p>
                                    <hr class="my-2">
                                    <div class="d-flex justify-content-between text-sm mb-1">
                                        <span><b>Check-in:</b></span>
                                        <span><%= new Date(booking.checkIn).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %></span>
                                    </div>
                                    <div class="d-flex justify-content-between text-sm mb-1">
                                        <span><b>Check-out:</b></span>
                                        <span><%= new Date(booking.checkOut).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %></span>
                                    </div>
                                    <div class="d-flex justify-content-between text-sm mb-1">
                                        <span><b>Duration:</b></span>
                                        <span><%= booking.nights %> night<%= booking.nights > 1 ? 's' : '' %></span>
                                    </div>
                                    <div class="d-flex justify-content-between text-sm mb-3">
                                        <span><b>Total Price:</b></span>
                                        <span class="text-success fw-bold">&#8377; <%= booking.totalPrice.toLocaleString("en-IN") %></span>
                                    </div>

                                    <form method="POST" action="/bookings/<%= booking._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                        <button class="btn btn-outline-danger btn-sm w-100">Cancel Booking</button>
                                    </form>
                                </div>
                            <% } else { %>
                                <div class="card-body">
                                    <p class="text-muted">Listing no longer available.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="alert alert-light border mb-5">
                <p class="mb-0">No upcoming trips booked yet. <a href="/listings" class="text-danger fw-bold">Explore destinations</a> to start planning your next getaway!</p>
            </div>
        <% } %>

        <!-- Past or Cancelled Trips -->
        <h4 class="mb-3">Past & Cancelled Trips</h4>
        <% if (pastOrCancelledBookings && pastOrCancelledBookings.length > 0) { %>
            <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
                <% for (let booking of pastOrCancelledBookings) { %>
                    <div class="col mb-4">
                        <div class="card h-100 shadow-sm border-0 rounded-3 bg-light opacity-75">
                            <% if (booking.listing) { %>
                                <img src="<%= booking.listing.image && booking.listing.image.url ? booking.listing.image.url : 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e' %>" 
                                     class="card-img-top" 
                                     alt="<%= booking.listing.title %>"
                                     style="height: 10rem; object-fit: cover; border-top-left-radius: 0.5rem; border-top-right-radius: 0.5rem;">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h5 class="card-title text-truncate mb-0" style="max-width: 70%;">
                                            <a href="/listings/<%= booking.listing._id %>" class="text-dark text-decoration-none"><%= booking.listing.title %></a>
                                        </h5>
                                        <% if (booking.status === 'cancelled') { %>
                                            <span class="badge bg-secondary">Cancelled</span>
                                        <% } else { %>
                                            <span class="badge bg-info text-dark">Completed</span>
                                        <% } %>
                                    </div>
                                    <p class="text-muted small mb-2"><i class="fa-solid fa-location-dot me-1"></i><%= booking.listing.location %>, <%= booking.listing.country %></p>
                                    <hr class="my-2">
                                    <div class="d-flex justify-content-between text-sm mb-1">
                                        <span><b>Check-in:</b></span>
                                        <span><%= new Date(booking.checkIn).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %></span>
                                    </div>
                                    <div class="d-flex justify-content-between text-sm mb-1">
                                        <span><b>Check-out:</b></span>
                                        <span><%= new Date(booking.checkOut).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %></span>
                                    </div>
                                    <div class="d-flex justify-content-between text-sm mb-1">
                                        <span><b>Total Price:</b></span>
                                        <span>&#8377; <%= booking.totalPrice.toLocaleString("en-IN") %></span>
                                    </div>
                                </div>
                            <% } else { %>
                                <div class="card-body">
                                    <p class="text-muted">Listing no longer available.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="alert alert-light border">
                <p class="mb-0">No past or cancelled trips.</p>
            </div>
        <% } %>
    </div>
</div>