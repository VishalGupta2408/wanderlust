<% layout("/layouts/boilerplate") %>

<div class="container my-4">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold mb-1"><i class="fa-solid fa-plane-departure text-danger me-2"></i>My Trips</h2>
            <p class="text-muted mb-0">Manage your bookings, view trip details, and explore your upcoming adventures.</p>
        </div>
        <a href="/listings" class="btn btn-outline-danger rounded-pill px-4 mt-3 mt-md-0 fw-semibold">
            <i class="fa-solid fa-magnifying-glass me-2"></i>Explore New Stay
        </a>
    </div>

    <%
        const allBookings = [...(upcomingBookings || []), ...(pastBookings || [])];
        const totalCount = allBookings.length;
        const confirmedCount = upcomingBookings ? upcomingBookings.length : 0;
        const pastCount = pastBookings ? pastBookings.filter(b => b.status === 'confirmed').length : 0;
        const cancelledCount = pastBookings ? pastBookings.filter(b => b.status === 'cancelled').length : 0;
    %>

    <!-- Stats Summary Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card stat-card border-0 shadow-sm rounded-4 p-3 bg-light">
                <div class="d-flex align-items-center">
                    <div class="stat-icon bg-danger-subtle text-danger rounded-circle p-3 me-3">
                        <i class="fa-solid fa-suitcase fs-4"></i>
                    </div>
                    <div>
                        <span class="fs-4 fw-bold d-block"><%= totalCount %></span>
                        <span class="text-muted small">Total Bookings</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card border-0 shadow-sm rounded-4 p-3 bg-light">
                <div class="d-flex align-items-center">
                    <div class="stat-icon bg-success-subtle text-success rounded-circle p-3 me-3">
                        <i class="fa-solid fa-calendar-check fs-4"></i>
                    </div>
                    <div>
                        <span class="fs-4 fw-bold d-block"><%= confirmedCount %></span>
                        <span class="text-muted small">Upcoming Trips</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card border-0 shadow-sm rounded-4 p-3 bg-light">
                <div class="d-flex align-items-center">
                    <div class="stat-icon bg-primary-subtle text-primary rounded-circle p-3 me-3">
                        <i class="fa-solid fa-circle-check fs-4"></i>
                    </div>
                    <div>
                        <span class="fs-4 fw-bold d-block"><%= pastCount %></span>
                        <span class="text-muted small">Completed</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card stat-card border-0 shadow-sm rounded-4 p-3 bg-light">
                <div class="d-flex align-items-center">
                    <div class="stat-icon bg-secondary-subtle text-secondary rounded-circle p-3 me-3">
                        <i class="fa-solid fa-ban fs-4"></i>
                    </div>
                    <div>
                        <span class="fs-4 fw-bold d-block"><%= cancelledCount %></span>
                        <span class="text-muted small">Cancelled</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Pills & Search Input -->
    <div class="row align-items-center g-3 mb-4">
        <div class="col-md-7">
            <div class="nav nav-pills trip-filter-pills gap-2" id="tripFilterTabs" role="tablist">
                <button class="nav-link active rounded-pill px-3 py-2 fw-semibold" data-filter="all">
                    All Trips (<%= totalCount %>)
                </button>
                <button class="nav-link rounded-pill px-3 py-2 fw-semibold" data-filter="upcoming">
                    <i class="fa-regular fa-clock me-1"></i>Upcoming (<%= confirmedCount %>)
                </button>
                <button class="nav-link rounded-pill px-3 py-2 fw-semibold" data-filter="completed">
                    <i class="fa-regular fa-circle-check me-1"></i>Completed (<%= pastCount %>)
                </button>
                <button class="nav-link rounded-pill px-3 py-2 fw-semibold" data-filter="cancelled">
                    <i class="fa-solid fa-ban me-1"></i>Cancelled (<%= cancelledCount %>)
                </button>
            </div>
        </div>
        <div class="col-md-5">
            <div class="position-relative">
                <i class="fa-solid fa-magnifying-glass position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                <input type="text" id="tripSearchInput" class="form-control rounded-pill ps-5 pe-3 py-2" placeholder="Search by destination or title...">
            </div>
        </div>
    </div>

    <!-- Trips Grid Placeholder -->
    <% if (totalCount === 0) { %>
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-5 bg-light">
            <div class="mb-3">
                <i class="fa-solid fa-map-location-dot text-danger opacity-75" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold">No trips booked yet!</h4>
            <p class="text-muted">You haven't booked any trips. Start exploring your next adventure!</p>
            <a href="/listings" class="btn btn-danger rounded-pill px-4 mt-2">Explore Listings</a>
        </div>
    <% } %>
</div>