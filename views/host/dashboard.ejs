<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2><i class="fa-solid fa-chart-line text-danger me-2"></i>Host Dashboard</h2>
            <a href="/listings/new" class="btn btn-danger add-btn">
                <i class="fa-solid fa-plus me-1"></i> Add New Listing
            </a>
        </div>

        <!-- Statistics Cards -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-6 g-3 mb-4">
            <div class="col">
                <div class="card h-100 shadow-sm border-0 bg-light text-center p-3">
                    <div class="text-danger mb-1 fs-3"><i class="fa-solid fa-house"></i></div>
                    <div class="fs-4 fw-bold"><%= totalListings %></div>
                    <div class="text-muted small">Total Listings</div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 shadow-sm border-0 bg-light text-center p-3">
                    <div class="text-primary mb-1 fs-3"><i class="fa-solid fa-calendar-check"></i></div>
                    <div class="fs-4 fw-bold"><%= totalBookingsCount %></div>
                    <div class="text-muted small">Total Bookings</div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 shadow-sm border-0 bg-light text-center p-3">
                    <div class="text-success mb-1 fs-3"><i class="fa-solid fa-indian-rupee-sign"></i></div>
                    <div class="fs-4 fw-bold">&#8377; <%= totalRevenue.toLocaleString("en-IN") %></div>
                    <div class="text-muted small">Total Revenue</div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 shadow-sm border-0 bg-light text-center p-3">
                    <div class="text-warning mb-1 fs-3"><i class="fa-solid fa-star"></i></div>
                    <div class="fs-4 fw-bold"><%= overallAvgRating %></div>
                    <div class="text-muted small">Avg Rating (<%= totalReviewsCount %>)</div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 shadow-sm border-0 bg-light text-center p-3">
                    <div class="text-info mb-1 fs-3"><i class="fa-solid fa-clock"></i></div>
                    <div class="fs-4 fw-bold"><%= upcomingBookings.length %></div>
                    <div class="text-muted small">Upcoming</div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 shadow-sm border-0 bg-light text-center p-3">
                    <div class="text-secondary mb-1 fs-3"><i class="fa-solid fa-circle-check"></i></div>
                    <div class="fs-4 fw-bold"><%= completedBookings.length %></div>
                    <div class="text-muted small">Completed</div>
                </div>
            </div>
        </div>

        <!-- Main Tabs -->
        <ul class="nav nav-tabs mb-4" id="dashboardTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active fw-semibold text-dark" id="listings-tab" data-bs-toggle="tab" data-bs-target="#listings-pane" type="button" role="tab" aria-controls="listings-pane" aria-selected="true">
                    <i class="fa-solid fa-list me-1"></i> My Listings (<%= totalListings %>)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link fw-semibold text-dark" id="bookings-tab" data-bs-toggle="tab" data-bs-target="#bookings-pane" type="button" role="tab" aria-controls="bookings-pane" aria-selected="false">
                    <i class="fa-solid fa-book me-1"></i> Guest Bookings (<%= totalBookingsCount %>)
                </button>
            </li>
        </ul>

        <div class="tab-content" id="dashboardTabsContent">
            <!-- Listings Tab -->
            <div class="tab-pane fade show active" id="listings-pane" role="tabpanel" aria-labelledby="listings-tab">
                <% if (listings && listings.length > 0) { %>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-4">
                        <% for (let listing of listings) { %>
                            <div class="col">
                                <div class="card h-100 shadow-sm listing-card">
                                    <img src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=800&q=60' %>" 
                                         class="card-img-top" 
                                         alt="<%= listing.title %>" 
                                         style="height: 200px; object-fit: cover;">
                                    <div class="card-body p-3">
                                        <h5 class="card-title text-truncate mb-1"><%= listing.title %></h5>
                                        <p class="text-muted small mb-2">
                                            <i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %>
                                        </p>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="fw-bold">&#8377; <%= (listing.price || 0).toLocaleString("en-IN") %> <small class="text-muted font-normal">/ night</small></span>
                                            <span class="badge bg-warning text-dark">
                                                <i class="fa-solid fa-star me-1"></i><%= listing.avgRating %> (<%= listing.reviewCount %>)
                                            </span>
                                        </div>
                                        <hr class="my-2">
                                        <div class="d-flex justify-content-between small text-secondary">
                                            <span><strong>Bookings:</strong> <%= listing.bookingCount %></span>
                                            <span><strong>Revenue:</strong> &#8377; <%= listing.revenue.toLocaleString("en-IN") %></span>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-white border-top-0 d-flex justify-content-end p-3">
                                        <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-dark">View Listing</a>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } else { %>
                    <div class="alert alert-light border text-center p-5 my-3">
                        <i class="fa-solid fa-house-chimney-crack fs-1 text-muted mb-3 d-block"></i>
                        <h4>No Listings Found</h4>
                        <p class="text-muted">You haven't added any listings yet. Start hosting today!</p>
                        <a href="/listings/new" class="btn btn-danger add-btn mt-2">Create Your First Listing</a>
                    </div>
                <% } %>
            </div>

            <!-- Bookings Tab -->
            <div class="tab-pane fade" id="bookings-pane" role="tabpanel" aria-labelledby="bookings-tab">
                <% if (bookings && bookings.length > 0) { %>
                    <div class="table-responsive shadow-sm rounded">
                        <table class="table table-hover align-middle mb-0 bg-white border">
                            <thead class="table-dark">
                                <tr>
                                    <th>Guest</th>
                                    <th>Listing</th>
                                    <th>Dates</th>
                                    <th>Duration</th>
                                    <th>Total Price</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (let booking of bookings) { %>
                                    <tr>
                                        <td>
                                            <div class="fw-bold"><%= booking.user ? booking.user.username : 'Unknown Guest' %></div>
                                            <div class="text-muted small"><%= booking.user ? booking.user.email : 'N/A' %></div>
                                        </td>
                                        <td>
                                            <% if (booking.listing) { %>
                                                <a href="/listings/<%= booking.listing._id %>" class="text-decoration-none text-dark fw-semibold">
                                                    <%= booking.listing.title %>
                                                </a>
                                            <% } else { %>
                                                <span class="text-muted">Listing Deleted</span>
                                            <% } %>
                                        </td>
                                        <td class="small">
                                            <%= new Date(booking.checkIn).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %> - 
                                            <%= new Date(booking.checkOut).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                        </td>
                                        <td><%= booking.nights %> <%= booking.nights === 1 ? 'night' : 'nights' %></td>
                                        <td class="fw-bold">&#8377; <%= (booking.totalPrice || 0).toLocaleString("en-IN") %></td>
                                        <td>
                                            <% if (booking.status === "confirmed") { %>
                                                <% if (new Date(booking.checkOut) < new Date()) { %>
                                                    <span class="badge bg-info text-dark">Completed</span>
                                                <% } else { %>
                                                    <span class="badge bg-success">Confirmed</span>
                                                <% } %>
                                            <% } else { %>
                                                <span class="badge bg-secondary">Cancelled</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (booking.status === "confirmed") { %>
                                                <form method="POST" action="/dashboard/bookings/<%= booking._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to cancel this booking?');" style="display:inline;">
                                                    <button class="btn btn-sm btn-outline-danger">Cancel Booking</button>
                                                </form>
                                            <% } else { %>
                                                <span class="text-muted small">N/A</span>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="alert alert-light border text-center p-5 my-3">
                        <i class="fa-regular fa-calendar-xmark fs-1 text-muted mb-3 d-block"></i>
                        <h4>No Bookings Received</h4>
                        <p class="text-muted">You haven't received any bookings for your listings yet.</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>